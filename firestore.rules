rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function roleDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    function claimOrganizationId() {
      return isSignedIn()
        && request.auth.token.get("organizationId", "") is string
        ? request.auth.token.get("organizationId", "")
        : "";
    }

    function organizationActive(orgId) {
      return orgId is string
        && orgId.size() > 0
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && !exists(/databases/$(database)/documents/organizationTombstones/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get("active", true) != false
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get("archived", false) != true
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get("status", "") in ["", "active"];
    }

    function sameOrg(orgId) {
      return hasVerifiedEmail()
        && roleDocExists()
        && orgId is string
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.organizationId == orgId
        && organizationActive(orgId)
        && (
          claimOrganizationId() == ""
          || claimOrganizationId() == orgId
        );
    }

    function isOrgAdmin(orgId) {
      return sameOrg(orgId)
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == "admin";
    }

    function isOrgStaff(orgId) {
      return sameOrg(orgId)
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ["admin", "sales"];
    }

    function inventoryAuthorityEnabled(orgId) {
      let settingsPath = /databases/$(database)/documents/organizations/$(orgId)/settings/config;
      return exists(settingsPath)
        && get(settingsPath).data.get("inventoryAuthorityEnabled", false) == true;
    }

    function managedMenuAvailabilityUpdateAllowed() {
      let previousActive = resource.data.get("active", true);
      let nextActive = request.resource.data.get("active", true);
      return nextActive == previousActive
        || (previousActive == false && nextActive == true);
    }

    function catalogRevisionAdvancedAndUnconfirmed(orgId) {
      let settingsPath = /databases/$(database)/documents/organizations/$(orgId)/settings/config;
      let currentSettings = get(settingsPath).data;
      let nextSettings = getAfter(settingsPath).data;
      return exists(settingsPath)
        && nextSettings.get("catalogRevision", 0) == currentSettings.get("catalogRevision", 0) + 1
        && nextSettings.get("pricingSetupConfirmed", false) == false
        && nextSettings.get("pricingConfirmation", null) == null;
    }

    function catalogProvenanceCreateSafe() {
      return request.resource.data.get("source", "") != "starter-catalog-pack"
        && !request.resource.data.keys().hasAny([
          "starterPackId",
          "starterPackVersion",
          "starterPackBaselineHash",
          "starterPackCatalogRevision"
        ]);
    }

    function catalogProvenanceUpdateSafe() {
      return request.resource.data.get("source", "") == resource.data.get("source", "")
        && request.resource.data.get("starterPackId", "") == resource.data.get("starterPackId", "")
        && request.resource.data.get("starterPackVersion", 0) == resource.data.get("starterPackVersion", 0)
        && request.resource.data.get("starterPackBaselineHash", "") == resource.data.get("starterPackBaselineHash", "")
        && request.resource.data.get("starterPackCatalogRevision", 0) == resource.data.get("starterPackCatalogRevision", 0);
    }

    function statusPatchOnly() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly([
        "status",
        "updatedAtISO",
        "lifecycle",
        "portalDecision"
      ])
      && affectedKeys.hasAll([
        "updatedAtISO",
        "lifecycle"
      ])
      && affectedKeys.hasAny([
        "status",
        "portalDecision"
      ])
      && resource.data.status in ["sent", "viewed"]
      && request.resource.data.status in ["viewed", "declined"]
      && validPortalDecisionPatch()
      && validPortalLifecyclePatch()
      && request.resource.data.portalKey == resource.data.portalKey;
    }

    function validPortalDecisionPatch() {
      return (
          request.resource.data.status == "viewed"
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["portalDecision"])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasAny(["portalDecision"])
          && request.resource.data.portalDecision is map
          && request.resource.data.portalDecision.keys().hasAll([
            "decision",
            "message",
            "requestId",
            "submittedAtISO"
          ])
          && request.resource.data.portalDecision.keys().hasOnly([
            "decision",
            "message",
            "requestId",
            "submittedAtISO"
          ])
          && request.resource.data.portalDecision.decision in [
            "declined",
            "changes_requested"
          ]
          && (
            (
              request.resource.data.portalDecision.decision == "changes_requested"
              && request.resource.data.status == "viewed"
            )
            || request.resource.data.portalDecision.decision == request.resource.data.status
          )
          && request.resource.data.portalDecision.message is string
          && request.resource.data.portalDecision.message.size() <= 1200
          && (
            request.resource.data.portalDecision.message.size() == 0
            || request.resource.data.portalDecision.message.matches('^(\\S|\\S[\\s\\S]*\\S)$')
          )
          && (
            request.resource.data.portalDecision.decision != "changes_requested"
            || request.resource.data.portalDecision.message.size() > 0
          )
          && request.resource.data.portalDecision.submittedAtISO is string
          && request.resource.data.portalDecision.submittedAtISO.size() > 0
          && request.resource.data.portalDecision.submittedAtISO.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$'
          )
          && request.resource.data.portalDecision.submittedAtISO == request.resource.data.updatedAtISO
          && request.resource.data.portalDecision.requestId is string
          && request.resource.data.portalDecision.requestId.matches('^[A-Za-z0-9-]{20,80}$')
        );
    }

    function portalChangeRequestDoesNotReplayHandledRecord() {
      let nextDecision = request.resource.data.get("portalDecision", {});
      let handling = resource.data.get("workflow", {}).get("changeRequestHandling", {});
      return nextDecision.get("decision", "") != "changes_requested"
        || handling.get("state", "") != "handled"
        || nextDecision.get("requestId", "") != handling.get("sourceRequestId", "");
    }

    function validPortalLifecyclePatch() {
      let previousLifecycle = resource.data.get("lifecycle", {});
      let nextLifecycle = request.resource.data.get("lifecycle", {});
      let lifecycleDiff = nextLifecycle.diff(previousLifecycle);
      return request.resource.data.updatedAtISO is string
        && request.resource.data.updatedAtISO.size() > 0
        && nextLifecycle is map
        && (
          (
            request.resource.data.status == "viewed"
            && lifecycleDiff.affectedKeys().hasOnly(["viewedAtISO"])
            && lifecycleDiff.affectedKeys().hasAll(["viewedAtISO"])
            && nextLifecycle.viewedAtISO == request.resource.data.updatedAtISO
          )
          || (
            request.resource.data.status == "declined"
            && lifecycleDiff.affectedKeys().hasOnly(["declinedAtISO"])
            && lifecycleDiff.affectedKeys().hasAll(["declinedAtISO"])
            && nextLifecycle.declinedAtISO == request.resource.data.updatedAtISO
          )
        );
    }

    function customerDecisionEvidenceUnchanged() {
      let previousLifecycle = resource.data.get("lifecycle", {});
      let nextLifecycle = request.resource.data.get("lifecycle", {});
      return request.resource.data.get("portalDecision", {}) == resource.data.get("portalDecision", {})
        && request.resource.data.get("acceptanceReceipt", null) == resource.data.get("acceptanceReceipt", null)
        && nextLifecycle.get("acceptedAtISO", "") == previousLifecycle.get("acceptedAtISO", "")
        && nextLifecycle.get("declinedAtISO", "") == previousLifecycle.get("declinedAtISO", "");
    }

    function salesBookingOperationsOnly() {
      let previousBooking = resource.data.get("booking", {});
      let nextBooking = request.resource.data.get("booking", {});
      return previousBooking is map
        && nextBooking is map
        && nextBooking.diff(previousBooking).affectedKeys().hasOnly([
          "staffLead",
          "staffAssignedAtISO",
          "kitchenCheckpoints",
          "productionChecklist"
        ]);
    }

    function salesFollowUpPatchOnly() {
      let previousWorkflow = resource.data.get("workflow", {});
      let nextWorkflow = request.resource.data.get("workflow", {});
      let followUp = nextWorkflow.get("followUp", {});
      return previousWorkflow is map
        && nextWorkflow is map
        && nextWorkflow.diff(previousWorkflow).affectedKeys().hasOnly(["followUp"])
        && followUp is map
        && followUp.keys().hasOnly([
          "stage",
          "dueDate",
          "note",
          "completed",
          "completedAtISO",
          "updatedAtISO",
          "updatedByEmail"
        ])
        && followUp.keys().hasAll([
          "stage",
          "dueDate",
          "note",
          "completed",
          "completedAtISO",
          "updatedAtISO",
          "updatedByEmail"
        ])
        && followUp.stage in [
          "new",
          "contacted",
          "proposal_sent",
          "awaiting_response",
          "won",
          "lost"
        ]
        && followUp.dueDate is string
        && followUp.dueDate.size() <= 10
        && followUp.note is string
        && followUp.note.size() <= 1200
        && followUp.completed is bool
        && followUp.completedAtISO is string
        && (
          (followUp.completed && followUp.completedAtISO.size() > 0)
          || (!followUp.completed && followUp.completedAtISO == "")
        )
        && followUp.updatedAtISO == request.resource.data.updatedAtISO
        && followUp.updatedByEmail == request.auth.token.email;
    }

    function changeRequestHandlingPatchOnly() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousWorkflow = resource.data.get("workflow", {});
      let nextWorkflow = request.resource.data.get("workflow", {});
      let previousHandling = previousWorkflow.get("changeRequestHandling", {});
      let nextHandling = nextWorkflow.get("changeRequestHandling", {});
      let sameRequest = previousHandling.get("sourceRequestId", "")
          == nextHandling.get("sourceRequestId", "")
        && previousHandling.get("sourceSubmittedAtISO", "")
          == nextHandling.get("sourceSubmittedAtISO", "")
        && previousHandling.get("sourceMessage", "")
          == nextHandling.get("sourceMessage", "");
      return affectedKeys.hasOnly(["workflow", "updatedAtISO"])
        && affectedKeys.hasAll(["workflow", "updatedAtISO"])
        && previousWorkflow is map
        && nextWorkflow is map
        && nextWorkflow.diff(previousWorkflow).affectedKeys().hasOnly(["changeRequestHandling"])
        && nextWorkflow.diff(previousWorkflow).affectedKeys().hasAll(["changeRequestHandling"])
        && resource.data.status != "deleted"
        && resource.data.get("portalDecision", {}).get("decision", "") == "changes_requested"
        && nextHandling is map
        && nextHandling.keys().hasOnly([
          "sourceRequestId",
          "sourceSubmittedAtISO",
          "sourceMessage",
          "state",
          "acknowledgedAtISO",
          "acknowledgedByEmail",
          "handledAtISO",
          "handledByEmail",
          "note"
        ])
        && nextHandling.keys().hasAll([
          "sourceRequestId",
          "sourceSubmittedAtISO",
          "sourceMessage",
          "state",
          "acknowledgedAtISO",
          "acknowledgedByEmail",
          "handledAtISO",
          "handledByEmail",
          "note"
        ])
        && nextHandling.sourceRequestId is string
        && nextHandling.sourceRequestId
          == resource.data.get("portalDecision", {}).get("requestId", "")
        && nextHandling.sourceSubmittedAtISO is string
        && nextHandling.sourceSubmittedAtISO.size() > 0
        && nextHandling.sourceSubmittedAtISO
          == resource.data.get("portalDecision", {}).get("submittedAtISO", "")
        && nextHandling.sourceMessage is string
        && nextHandling.sourceMessage.size() > 0
        && nextHandling.sourceMessage.size() <= 1200
        && nextHandling.sourceMessage
          == resource.data.get("portalDecision", {}).get("message", "")
        && nextHandling.state in ["acknowledged", "handled"]
        && request.resource.data.updatedAtISO is string
        && request.resource.data.updatedAtISO.size() > 0
        && nextHandling.acknowledgedAtISO is string
        && nextHandling.acknowledgedAtISO.size() > 0
        && nextHandling.acknowledgedByEmail is string
        && nextHandling.handledAtISO is string
        && nextHandling.handledByEmail is string
        && nextHandling.note is string
        && nextHandling.note.size() <= 800
        && (
          (
            !sameRequest
            && nextHandling.acknowledgedAtISO == request.resource.data.updatedAtISO
            && nextHandling.acknowledgedByEmail == request.auth.token.email
            && (
              (
                nextHandling.state == "acknowledged"
                && nextHandling.handledAtISO == ""
                && nextHandling.handledByEmail == ""
                && nextHandling.note == ""
              )
              || (
                nextHandling.state == "handled"
                && nextHandling.handledAtISO == request.resource.data.updatedAtISO
                && nextHandling.handledByEmail == request.auth.token.email
                && nextHandling.note.size() > 0
              )
            )
          )
          || (
            sameRequest
            && previousHandling.get("state", "") == "acknowledged"
            && nextHandling.state == "handled"
            && nextHandling.acknowledgedAtISO == previousHandling.get("acknowledgedAtISO", "")
            && nextHandling.acknowledgedByEmail == previousHandling.get("acknowledgedByEmail", "")
            && nextHandling.handledAtISO == request.resource.data.updatedAtISO
            && nextHandling.handledByEmail == request.auth.token.email
            && nextHandling.note.size() > 0
          )
        );
    }

    function staffVersionPointerPatchAllowed(orgId, quoteId) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let previousVersionNumber = resource.data.get("latestVersionNumber", 0);
      let nextVersionNumber = request.resource.data.get("latestVersionNumber", 0);
      let versionMeta = request.resource.data.get("versionMeta", {});
      let versionId = versionMeta.get("versionId", "");
      let versionPath = /databases/$(database)/documents/organizations/$(orgId)/quotes/$(quoteId)/versions/$(versionId);
      return affectedKeys.hasOnly([
          "activeVersionId",
          "latestVersionNumber",
          "versionMeta"
        ])
        && affectedKeys.hasAll([
          "latestVersionNumber",
          "versionMeta"
        ])
        && previousVersionNumber is int
        && nextVersionNumber is int
        && nextVersionNumber == previousVersionNumber + 1
        && versionMeta is map
        && versionMeta.get("versionNumber", 0) == nextVersionNumber
        && versionMeta.get("createdAt", "") is string
        && versionMeta.get("createdAt", "").size() > 0
        && versionMeta.get("reason", "") is string
        && versionMeta.get("reason", "").size() > 0
        && versionId is string
        && versionId.size() >= 5
        && existsAfter(versionPath)
        && getAfter(versionPath).data.versionId == versionId
        && getAfter(versionPath).data.versionNumber == nextVersionNumber
        && getAfter(versionPath).data.createdAtISO == versionMeta.createdAt
        && getAfter(versionPath).data.reason == versionMeta.reason
        && getAfter(versionPath).data.createdBy == versionMeta.createdBy
        && (
          !affectedKeys.hasAny(["activeVersionId"])
          || (
            isOrgAdmin(orgId)
            && resource.data.get("activeVersionId", "") == ""
            && request.resource.data.activeVersionId == versionId
          )
        );
    }

    function staffOperationalPatchAllowed(orgId, quoteId) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return staffVersionPointerPatchAllowed(orgId, quoteId)
        || (
          affectedKeys.hasOnly([
            "booking",
            "workflow",
            "integrations",
            "updatedAtISO"
          ])
          && (
            !affectedKeys.hasAny(["booking"])
            || (
              serverOwnedContractEvidenceUnchanged()
              && (
                isOrgAdmin(orgId)
                || salesBookingOperationsOnly()
              )
            )
          )
          && (
            !affectedKeys.hasAny(["workflow"])
            || salesFollowUpPatchOnly()
            || changeRequestHandlingPatchOnly()
          )
          && (
            !affectedKeys.hasAny(["integrations"])
            || isOrgAdmin(orgId)
          )
        );
    }

    function staffNonterminalTransitionPatchOnly() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly([
          "status",
          "deletedAtISO",
          "updatedAtISO",
          "lifecycle"
        ])
        && affectedKeys.hasAll([
          "status",
          "updatedAtISO"
        ]);
    }

    function serverOwnedPaymentEvidenceUnchanged() {
      let previousPayment = resource.data.get("payment", {});
      let nextPayment = request.resource.data.get("payment", {});
      return previousPayment is map
        && nextPayment is map
        && [
          nextPayment.get("finalBalance", {}),
          nextPayment.get("ledger", {}),
          nextPayment.get("depositLink", ""),
          nextPayment.get("depositStatus", "unpaid"),
          nextPayment.get("depositConfirmedAtISO", ""),
          nextPayment.get("stripeSessionId", ""),
          nextPayment.get("stripeCheckoutState", ""),
          nextPayment.get("lastCheckoutCreatedAtISO", ""),
          nextPayment.get("lastHost", ""),
          nextPayment.get("lastEventType", ""),
          nextPayment.get("lastOrganizationId", ""),
          nextPayment.get("checkoutGeneration", 0),
          nextPayment.get("knownStripeSessionIds", [])
        ] == [
          previousPayment.get("finalBalance", {}),
          previousPayment.get("ledger", {}),
          previousPayment.get("depositLink", ""),
          previousPayment.get("depositStatus", "unpaid"),
          previousPayment.get("depositConfirmedAtISO", ""),
          previousPayment.get("stripeSessionId", ""),
          previousPayment.get("stripeCheckoutState", ""),
          previousPayment.get("lastCheckoutCreatedAtISO", ""),
          previousPayment.get("lastHost", ""),
          previousPayment.get("lastEventType", ""),
          previousPayment.get("lastOrganizationId", ""),
          previousPayment.get("checkoutGeneration", 0),
          previousPayment.get("knownStripeSessionIds", [])
        ];
    }

    function serverOwnedContractEvidenceUnchanged() {
      let previousBooking = resource.data.get("booking", {});
      let nextBooking = request.resource.data.get("booking", {});
      return previousBooking is map
        && nextBooking is map
        && nextBooking.get("bookedAtISO", "") == previousBooking.get("bookedAtISO", "")
        && nextBooking.get("bookedByEmail", "") == previousBooking.get("bookedByEmail", "")
        && nextBooking.get("contractNumber", "") == previousBooking.get("contractNumber", "")
        && nextBooking.get("contractConvertedAtISO", "") == previousBooking.get("contractConvertedAtISO", "")
        && nextBooking.get("contractConvertedByEmail", "") == previousBooking.get("contractConvertedByEmail", "")
        && nextBooking.get("availabilityCheckedAtISO", "") == previousBooking.get("availabilityCheckedAtISO", "")
        && nextBooking.get("availabilitySummary", {}) == previousBooking.get("availabilitySummary", {});
    }

    function staffQuoteStatusUpdateAllowed(orgId, quoteId) {
      return !(resource.data.get("workflow", {}).get("quoteDelivery", {}).get("state", "") in ["sending", "outcome_ambiguous", "outcome_unknown"])
        && serverOwnedPaymentEvidenceUnchanged()
        && customerDecisionEvidenceUnchanged()
        && (
          (
            request.resource.data.status == resource.data.status
            && staffOperationalPatchAllowed(orgId, quoteId)
          )
          || (
            request.resource.data.status != resource.data.status
            && !(resource.data.status in ["accepted", "declined", "booked", "expired", "deleted"])
            && request.resource.data.status == "expired"
            && staffNonterminalTransitionPatchOnly()
            && isOrgAdmin(orgId)
          )
        );
    }

    function portalSnapshotExists(portalKey) {
      return portalKey is string
        && portalKey.size() >= 20
        && exists(/databases/$(database)/documents/customerPortalQuotes/$(portalKey));
    }

    function portalDeliveryEvidenceActive(data, portalKey) {
      let evidence = data.get("deliveryEvidence", {});
      return evidence is map
        && evidence.keys().hasOnly([
          "revisionId",
          "state",
          "portalActivationState",
          "portalKey",
          "portalIssuedAtISO",
          "providerAcceptedAtISO"
        ])
        && evidence.keys().hasAll([
          "revisionId",
          "state",
          "portalActivationState",
          "portalKey",
          "portalIssuedAtISO",
          "providerAcceptedAtISO"
        ])
        && evidence.revisionId is string
        && evidence.revisionId.size() > 0
        && evidence.state == "provider_accepted"
        && evidence.portalActivationState == "active"
        && evidence.portalKey == portalKey
        && data.get("portalIssuedAtISO", "") is string
        && data.get("portalIssuedAtISO", "").size() > 0
        && evidence.portalIssuedAtISO is string
        && evidence.portalIssuedAtISO.size() > 0
        && evidence.portalIssuedAtISO == data.get("portalIssuedAtISO", "")
        && evidence.providerAcceptedAtISO is string
        && evidence.providerAcceptedAtISO.size() > 0;
    }

    function portalSnapshotDataActive(data, portalKey) {
      return data.portalKey == portalKey
        && data.organizationId is string
        && organizationActive(data.organizationId)
        && data.status in ["sent", "viewed", "accepted", "declined", "booked"]
        && portalDeliveryEvidenceActive(data, portalKey)
        && (
          data.portalExpiresAtMs is int
          || data.portalExpiresAtMs is float
        )
        && data.portalExpiresAtMs > request.time.toMillis();
    }

    function portalSnapshotActive(portalKey) {
      return portalSnapshotExists(portalKey)
        && portalSnapshotDataActive(
          get(/databases/$(database)/documents/customerPortalQuotes/$(portalKey)).data,
          portalKey
        );
    }

    function portalStateMatchesOrgQuoteAfter(portalKey, quoteId, orgId) {
      let portalPath = /databases/$(database)/documents/customerPortalQuotes/$(portalKey);
      let portalData = getAfter(portalPath).data;
      return existsAfter(portalPath)
        && portalData.quoteId == quoteId
        && portalData.organizationId == orgId
        && portalData.status == request.resource.data.status
        && portalData.get("portalDecision", {}) == request.resource.data.get("portalDecision", {})
        && portalData.get("updatedAtISO", "") == request.resource.data.get("updatedAtISO", "")
        && portalData.get("lifecycle", {}) == request.resource.data.get("lifecycle", {});
    }

    function portalMatchesOrgQuoteAfter(portalKey, quoteId, orgId) {
      let portalPath = /databases/$(database)/documents/customerPortalQuotes/$(portalKey);
      return portalStateMatchesOrgQuoteAfter(portalKey, quoteId, orgId)
        && portalSnapshotDataActive(getAfter(portalPath).data, portalKey);
    }

    function portalUpdateMatchesOrgQuoteAfter(orgId, quoteId, portalKey) {
      let quotePath = /databases/$(database)/documents/organizations/$(orgId)/quotes/$(quoteId);
      let quoteData = getAfter(quotePath).data;
      return existsAfter(quotePath)
        && quoteData.organizationId == orgId
        && quoteData.portalKey == portalKey
        && quoteData.status == request.resource.data.status
        && quoteData.get("portalDecision", {}) == request.resource.data.get("portalDecision", {})
        && quoteData.get("updatedAtISO", "") == request.resource.data.get("updatedAtISO", "")
        && quoteData.get("lifecycle", {}) == request.resource.data.get("lifecycle", {});
    }

    function portalStatusPatchOnly(portalKey) {
      return statusPatchOnly()
        && request.resource.data.portalKey == portalKey
        && resource.data.portalKey == portalKey;
    }

    function orgQuoteStaffUpdateAllowed(orgId, quoteId) {
      return isSignedIn()
        && isOrgStaff(orgId)
        && resource.data.organizationId == orgId
        && request.resource.data.organizationId == orgId
        && request.resource.data.portalKey == resource.data.portalKey
        && staffQuoteStatusUpdateAllowed(orgId, quoteId)
        && (
          request.resource.data.status == resource.data.status
          || portalStateMatchesOrgQuoteAfter(resource.data.portalKey, quoteId, orgId)
        );
    }

    function orgQuotePortalUpdateAllowed(orgId, quoteId) {
      return (
          !isSignedIn()
          || !isOrgStaff(orgId)
        )
        && !(resource.data.get("workflow", {}).get("quoteDelivery", {}).get("state", "") in ["sending", "outcome_ambiguous", "outcome_unknown"])
        && statusPatchOnly()
        && portalChangeRequestDoesNotReplayHandledRecord()
        && portalMatchesOrgQuoteAfter(resource.data.portalKey, quoteId, orgId);
    }

    function portalStaffUpdateAllowed(portalKey) {
      let orgId = resource.data.organizationId;
      let quoteId = resource.data.quoteId;
      let quotePath = /databases/$(database)/documents/organizations/$(orgId)/quotes/$(quoteId);
      return isSignedIn()
        && orgId is string
        && quoteId is string
        && exists(quotePath)
        && !(get(quotePath).data.get("workflow", {}).get("quoteDelivery", {}).get("state", "") in ["sending", "outcome_ambiguous", "outcome_unknown"])
        && isOrgStaff(orgId)
        && request.resource.data.organizationId == orgId
        && request.resource.data.portalKey == resource.data.portalKey
        && request.resource.data.quoteId == quoteId
        && staffQuoteStatusUpdateAllowed(orgId, quoteId)
        && portalUpdateMatchesOrgQuoteAfter(orgId, quoteId, portalKey);
    }

    function portalCustomerUpdateAllowed(portalKey) {
      let orgId = resource.data.organizationId;
      let quoteId = resource.data.quoteId;
      let quotePath = /databases/$(database)/documents/organizations/$(orgId)/quotes/$(quoteId);
      return orgId is string
        && quoteId is string
        && quoteId.size() > 0
        && exists(quotePath)
        && !(get(quotePath).data.get("workflow", {}).get("quoteDelivery", {}).get("state", "") in ["sending", "outcome_ambiguous", "outcome_unknown"])
        && (
          !isSignedIn()
          || !isOrgStaff(orgId)
        )
        && portalStatusPatchOnly(portalKey)
        && portalSnapshotDataActive(resource.data, portalKey)
        && portalUpdateMatchesOrgQuoteAfter(
          orgId,
          quoteId,
          portalKey
        );
    }

    function validQuoteVersionCreate(orgId, quoteId, versionId) {
      let quotePath = /databases/$(database)/documents/organizations/$(orgId)/quotes/$(quoteId);
      let quoteData = get(quotePath).data;
      let quoteDataAfter = getAfter(quotePath).data;
      let snapshot = request.resource.data.snapshot;
      return exists(quotePath)
        && request.resource.data.organizationId == orgId
        && request.resource.data.quoteId == quoteId
        && request.resource.data.versionId == versionId
        && request.resource.data.versionNumber is int
        && request.resource.data.versionNumber > 0
        && quoteDataAfter.latestVersionNumber == request.resource.data.versionNumber
        && quoteDataAfter.versionMeta.versionId == versionId
        && quoteDataAfter.versionMeta.versionNumber == request.resource.data.versionNumber
        && request.resource.data.createdAtISO is string
        && request.resource.data.createdAtISO.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && request.resource.data.status is string
        && request.resource.data.createdBy is map
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.createdBy.email == request.auth.token.email
        && request.resource.data.pricing is map
        && request.resource.data.snapshot is map
        && request.resource.data.get("customerId", "") == quoteDataAfter.get("customerId", "")
        && snapshot.get("customerId", "") == quoteDataAfter.get("customerId", "")
        && request.resource.data.pricing == quoteData.pricing
        && snapshot.organizationId == orgId
        && snapshot.id == quoteId
        && snapshot.quoteNumber == quoteData.quoteNumber
        && snapshot.portalKey == quoteData.portalKey
        && snapshot.ownerUid == quoteData.ownerUid
        && snapshot.ownerEmail == quoteData.ownerEmail
        && snapshot.customer == quoteData.customer
        && snapshot.event == quoteData.event
        && snapshot.selection == quoteData.selection
        && snapshot.totals == quoteData.totals
        && snapshot.pricing == quoteData.pricing
        && snapshot.get("payment", {}) == quoteData.get("payment", {})
        && snapshot.status == quoteData.status
        && quoteData.status == request.resource.data.status;
    }

    function commercialSettingsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "plan",
        "featureFlagsLocked",
        "featureFlagsPaid",
        "featureFlagsLockReason",
        "featureFlagsLockUpdatedAtISO",
        "commercialChangeAuthorityEnabled",
        "operationalStaffingAuthorityEnabled",
        "inventoryAuthorityEnabled",
        "googleCalendarIntegrationEnabled",
        "eventOperatingSpineEnabled",
        "orderId",
        "onboarding"
      ])
      && (
        resource.data.get("featureFlagsLocked", false) != true
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "featureFlags"
        ])
      );
    }

    function commercialSettingsCreateSafe() {
      return !request.resource.data.keys().hasAny([
        "plan",
        "featureFlags",
        "featureFlagsLocked",
        "featureFlagsPaid",
        "featureFlagsLockReason",
        "featureFlagsLockUpdatedAtISO",
        "commercialChangeAuthorityEnabled",
        "operationalStaffingAuthorityEnabled",
        "inventoryAuthorityEnabled",
        "googleCalendarIntegrationEnabled",
        "eventOperatingSpineEnabled",
        "orderId",
        "onboarding"
      ])
      && request.resource.data.get("pricingSetupConfirmed", false) == false
      && request.resource.data.get("pricingConfirmation", null) == null;
    }

    function pricingConfirmationAuthoritySafe() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return (
          !affectedKeys.hasAny(["pricingSetupConfirmed"])
          || request.resource.data.get("pricingSetupConfirmed", false) == false
        )
        && (
          !affectedKeys.hasAny(["pricingConfirmation"])
          || (
            request.resource.data.get("pricingConfirmation", null) == null
            && request.resource.data.get("pricingSetupConfirmed", false) == false
          )
        );
    }

    function catalogSettingsAuthoritySafe(orgId) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let catalogSettingsChanged = affectedKeys.hasAny([
        "perMileRate",
        "perMileRateMinor",
        "longDistancePerMileRate",
        "longDistancePerMileRateMinor",
        "deliveryThresholdMiles",
        "capacityLimit",
        "serviceFeePct",
        "serviceFeeTiers",
        "taxRate",
        "taxRegions",
        "defaultTaxRegion",
        "depositPct",
        "depositNotice",
        "quoteValidityDays",
        "staffingChargeMode",
        "staffingLaborEnabled",
        "bartenderRate",
        "bartenderRateMinor",
        "bartenderRateTypes",
        "defaultBartenderRateType",
        "serverRate",
        "serverRateMinor",
        "chefRate",
        "chefRateMinor",
        "staffingRateTypes",
        "defaultStaffingRateType",
        "seasonalProfiles",
        "defaultSeasonProfile",
        "eventTemplates",
        "upsellRules",
        "guidedSellingEnabled",
        "menuSections",
        "pricingSettingsVersion",
        "pricingSettingsUpdatedAtISO"
      ]);
      return !affectedKeys.hasAny(["starterCatalogPack"])
        && (
          !(catalogSettingsChanged || affectedKeys.hasAny(["catalogRevision"]))
          || catalogRevisionAdvancedAndUnconfirmed(orgId)
        );
    }

    match /userRoles/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || (
          resource.data.organizationId is string
          && isOrgAdmin(resource.data.organizationId)
        )
      );
      allow create, update, delete: if false;
    }

    match /organizationOwnerBindingReceipts/{organizationId} {
      allow read, create, update, delete: if false;
    }

    match /organizationRoleAuthorityReceipts/{requestId} {
      allow read, create, update, delete: if false;
    }

    // Google OAuth state contains a short-lived encrypted verifier and exact
    // actor/tenant bindings. Only trusted Functions may read or mutate it.
    match /googleCalendarOAuthStates/{stateId} {
      allow read, create, update, delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if isOrgStaff(orgId);
      allow create, update, delete: if false;
    }

    match /tenantDomains/{hostname} {
      allow read: if resource.data.organizationId is string
        && isOrgAdmin(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && isOrgAdmin(request.resource.data.organizationId);
      allow update: if resource.data.organizationId is string
        && request.resource.data.organizationId is string
        && resource.data.organizationId == request.resource.data.organizationId
        && isOrgAdmin(resource.data.organizationId);
      allow delete: if resource.data.organizationId is string
        && isOrgAdmin(resource.data.organizationId);
    }

    match /organizations/{orgId}/settings/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && commercialSettingsCreateSafe();
      allow delete: if false;
      allow update: if isOrgAdmin(orgId)
        && commercialSettingsUnchanged()
        && pricingConfirmationAuthoritySafe()
        && catalogSettingsAuthoritySafe(orgId);
    }

    match /organizations/{orgId}/catalogPackages/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && catalogProvenanceCreateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow update: if isOrgAdmin(orgId)
        && catalogProvenanceUpdateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow delete: if isOrgAdmin(orgId)
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
    }

    match /organizations/{orgId}/catalogAddons/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && catalogProvenanceCreateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow update: if isOrgAdmin(orgId)
        && catalogProvenanceUpdateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow delete: if isOrgAdmin(orgId)
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
    }

    match /organizations/{orgId}/catalogRentals/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && catalogProvenanceCreateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow update: if isOrgAdmin(orgId)
        && catalogProvenanceUpdateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow delete: if isOrgAdmin(orgId)
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
    }

    match /organizations/{orgId}/eventTypes/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && catalogProvenanceCreateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow update: if isOrgAdmin(orgId)
        && catalogProvenanceUpdateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow delete: if isOrgAdmin(orgId)
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
    }

    match /organizations/{orgId}/menuCategories/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && catalogProvenanceCreateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow update: if isOrgAdmin(orgId)
        && catalogProvenanceUpdateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow delete: if isOrgAdmin(orgId)
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
    }

    match /organizations/{orgId}/menuItems/{docId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgAdmin(orgId)
        && catalogProvenanceCreateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow update: if isOrgAdmin(orgId)
        && managedMenuAvailabilityUpdateAllowed()
        && catalogProvenanceUpdateSafe()
        && catalogRevisionAdvancedAndUnconfirmed(orgId);
      allow delete: if false;
    }

    match /organizations/{orgId}/customers/{docId} {
      allow get: if isOrgStaff(orgId);
      allow list: if isOrgStaff(orgId)
        && request.query.limit != null
        && request.query.limit <= 101;
      // Customer identity, normalized directory search fields, import
      // provenance, and rollback decisions are all trusted-server owned.
      allow write: if false;
    }

    match /organizations/{orgId}/customerEmailClaims/{claimId} {
      // Normalized email ownership is a trusted transaction serialization
      // primitive, not customer-directory data.
      allow read, write: if false;
    }

    // Inquiry Showcase drafts, immutable publications, customer submissions,
    // lifecycle receipts, and conversion evidence are callable-owned. Even
    // same-tenant staff use bounded role-checked projections.
    match /organizations/{orgId}/inquiryShowcases/{showcaseId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inquiryShowcases/{showcaseId}/versions/{versionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inquiryShowcases/{showcaseId}/receipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/customerInquiries/{inquiryId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/customerInquiries/{inquiryId}/receipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/importBatches/{batchId} {
      allow read: if isOrgAdmin(orgId);
      allow write: if false;
    }

    // Catalog setup drafts, publication receipts, and quote catalog review
    // outcomes are trusted callable-owned authority. Browser clients receive
    // only bounded same-tenant projections after role verification.
    match /organizations/{orgId}/catalogSetupDrafts/{draftId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/catalogPublicationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quoteCatalogReviewReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quoteApprovalExecutions/{executionId} {
      allow read: if isOrgAdmin(orgId);
      allow write: if false;
    }

    match /organizations/{orgId}/privatePaymentDispatches/{dispatchId} {
      allow read, write: if false;
    }

    // Controlled Resend acceptance requests and provider receipts are owned by
    // the trusted callable. Browsers receive only the bounded callable result
    // and Operations Audit projection, never the stored private record.
    match /organizations/{orgId}/resendAcceptanceReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Buyer checkout identity, provider state, and fulfillment evidence are
    // server-owned. Browser clients use owner-scoped callables instead of
    // reading or mutating these records directly.
    match /buyerAccessOrders/{orderId} {
      allow read, write: if false;
    }

    match /inquirySlugs/{slug} {
      allow read, write: if false;
    }

    match /publicInquiryRequests/{requestId} {
      allow read, write: if false;
    }

    match /inquiryRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /inquiryDeletionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /inquiryAnalytics/{aggregateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/proposalAcceptanceReceipts/{receiptId} {
      allow read: if isOrgStaff(orgId);
      allow write: if false;
    }

    match /organizations/{orgId}/productAnalyticsEvents/{eventId} {
      allow read, write: if false;
    }

    // Steward runs, packets, audit/usage/entitlement receipts, reviewed client
    // memory, policy versions, deletion evidence, and incident controls are
    // trusted-server-only records. A later callable may project a bounded DTO,
    // but no browser role may discover, read, list, create, alter, or delete
    // these private records directly.
    match /organizations/{orgId}/stewardRuns/{runId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardPackets/{packetId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardAuditReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardUsageBuckets/{bucketId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardEntitlementReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardClientMemory/{memoryId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardPolicies/{policyId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardDeletionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/stewardIncidentDirectives/{directiveId} {
      allow read, write: if false;
    }

    // Post-event closeout records and exact action receipts are callable-owned.
    // Staff consume the bounded projection on the canonical quote; customer
    // portal records never receive this internal operational evidence.
    match /organizations/{orgId}/postEventCloseouts/{closeoutId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/postEventCloseouts/{closeoutId}/actionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/postEventCloseouts/{closeoutId}/attendanceReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Event phase ledgers and immutable command receipts are server-private.
    // Staff receive only bounded callable snapshots; no browser role owns these records.
    match /organizations/{orgId}/eventOperatingLedgers/{ledgerId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventOperatingLedgers/{ledgerId}/receipts/{requestHash} {
      allow read, write: if false;
    }

    // Work journals have separate revision and receipt authority; no browser
    // principal may access current work state or immutable work receipts directly.
    match /organizations/{orgId}/eventOperatingLedgers/{ledgerId}/workState/{stateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventOperatingLedgers/{ledgerId}/workReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Declared actuals and their receipts are independent server authority.
    // Browser reads, lists, and writes are denied for every principal.
    match /organizations/{orgId}/eventOperatingLedgers/{ledgerId}/actualsState/{stateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventOperatingLedgers/{ledgerId}/actualsReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Workflow definitions, publications, instances and receipts are server-private.
    // Even administrators use bounded callables rather than direct browser reads.
    match /organizations/{orgId}/workflowDefinitions/{definitionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/workflowDefinitions/{definitionId}/versions/{versionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/workflowDefinitions/{definitionId}/lifecycleReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/workflowInstances/{instanceId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/workflowInstances/{instanceId}/receipts/{receiptId} {
      allow read, write: if false;
    }

    // Native adapter proof and attendance journals are server-only evidence.
    // An issued customer portal token grants no direct document access.
    match /organizations/{orgId}/workflowInstances/{instanceId}/observations/{evidenceId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quoteAttendance/{ledgerId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quoteAttendance/{ledgerId}/receipts/{receiptId} {
      allow read, write: if false;
    }

    // Operational staffing profiles, event plans and immutable versions, and
    // scheduling fences are trusted-server authority. Browser clients consume
    // only bounded, role-safe projections returned by callables.
    match /organizations/{orgId}/staffProfiles/{staffProfileId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/staffProfiles/{staffProfileId}/versions/{versionId} {
      allow read, write: if false;
    }

    // Full staff contact, compensation, qualifications and private notes are
    // admin-callable-owned. They are intentionally separate from the bounded
    // operational profile used for assignment planning.
    match /organizations/{orgId}/staffRecords/{staffRecordId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/staffRecords/{staffRecordId}/versions/{versionId} {
      allow read, write: if false;
    }

    // Assignment invitations, dispatch/acknowledgement receipts, and signed
    // provider events are callable-owned. Staff and public responders receive
    // only bounded projections after role or bearer-token verification.
    match /organizations/{orgId}/staffInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/staffInvitations/{invitationId}/staffInvitationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/staffInvitationProviderEvents/{eventId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventStaffingPlans/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventStaffingPlans/{quoteId}/versions/{versionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/staffingScheduleFences/{fenceId} {
      allow read, write: if false;
    }

    // Ingredient definitions, immutable stock/cost evidence, rebuildable
    // current states, recipes, event demand, allocations, receipts, and
    // deterministic insights are trusted-server authority. Browser clients
    // may read only the bounded projections declared below.
    match /organizations/{orgId}/inventoryLocations/{locationId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryItems/{itemId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryIngredients/{ingredientId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryMovements/{movementId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryStockStates/{stockStateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryCostEvidence/{evidenceId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryCostStates/{costStateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryAuthorityState/{stateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryAuthorityReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Recipe and pack-conversion publications are immutable server evidence.
    // Mutable heads and the reverse dependency index are coordination state,
    // not browser authority. Publication receipts share the existing inventory
    // receipt collection above so request IDs remain collision-safe across the
    // whole ingredient authority.
    match /organizations/{orgId}/inventoryRecipePolicies/{recipeRevisionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryRecipeHeads/{menuItemId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryPackConversionRevisions/{packConversionRevisionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryPackConversionHeads/{conversionHeadId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryRecipeDependencyIndex/{ingredientId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventIngredientDependencyIndex/{menuItemId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventIngredientRequirementHeads/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventIngredientRequirements/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventIngredientRequirements/{quoteId}/revisions/{requirementRevisionId} {
      allow read, write: if false;
    }

    // Current consumable allocation plans and their immutable revisions are
    // callable-owned coordination/evidence. Staff consume only the exact safe
    // event projection below; no browser actor reads or mutates allocation truth.
    match /organizations/{orgId}/eventIngredientPlans/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventIngredientPlans/{quoteId}/revisions/{planRevisionId} {
      allow read, write: if false;
    }

    // Internal supply action-plan heads, immutable revisions, and command
    // receipts are callable-owned. They may contain supplier/cost planning
    // notes but never vendor, purchase-order, reservation, or commercial
    // authority, and browsers have no direct read or write path.
    match /organizations/{orgId}/eventSupplyActionPlans/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventSupplyActionPlans/{quoteId}/revisions/{planRevisionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventSupplyActionPlanReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Event ingredient execution heads and immutable revisions are physical-use
    // authority. Browsers consume only the bounded, exact-event projection
    // below; direct reads and every mutation stay server-owned.
    match /organizations/{orgId}/eventIngredientExecutions/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventIngredientExecutions/{quoteId}/revisions/{executionRevisionId} {
      allow read, write: if false;
    }

    // Location/setup data stays in one exact, server-owned projection. The
    // first Phase-2 route is administrator-only and has no browser write path.
    match /organizations/{orgId}/inventoryWorkspaceProjections/{projectionId} {
      allow get: if projectionId == "current"
        && isOrgAdmin(orgId)
        && inventoryAuthorityEnabled(orgId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Ingredient rows are materialized independently to avoid a tenant-global
    // hot document. Realtime list reads must remain explicitly bounded.
    match /organizations/{orgId}/inventoryIngredientProjections/{ingredientId} {
      allow get: if isOrgAdmin(orgId)
        && inventoryAuthorityEnabled(orgId);
      allow list: if isOrgAdmin(orgId)
        && inventoryAuthorityEnabled(orgId)
        && request.query.limit != null
        && request.query.limit <= 200;
      allow create, update, delete: if false;
    }

    // Menu costing is safe commercial consequence intelligence for same-tenant
    // staff. Reads stay feature-gated and bounded; canonical recipes, cost
    // evidence, dependency state, and every projection write remain server-only.
    match /organizations/{orgId}/inventoryMenuCostProjections/{menuItemId} {
      allow get: if isOrgStaff(orgId)
        && inventoryAuthorityEnabled(orgId);
      allow list: if isOrgStaff(orgId)
        && inventoryAuthorityEnabled(orgId)
        && request.query.limit != null
        && request.query.limit <= 200;
      allow create, update, delete: if false;
    }

    // Event ingredient consequence intelligence is consumed from one exact
    // quote projection. Collection scans and every browser mutation remain
    // forbidden; canonical requirements and heads stay private above.
    match /organizations/{orgId}/eventIngredientProjections/{quoteId} {
      allow get: if isOrgStaff(orgId)
        && inventoryAuthorityEnabled(orgId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Physical-use settlement is intentionally projected separately from
    // commercial demand/cost intelligence so one authority cannot manufacture
    // freshness for the other. Only exact event reads are allowed.
    match /organizations/{orgId}/eventIngredientExecutionProjections/{quoteId} {
      allow get: if isOrgStaff(orgId)
        && inventoryAuthorityEnabled(orgId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /organizations/{orgId}/inventoryRequirementPolicies/{policyRevisionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventInventoryRequirements/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventInventoryRequirements/{quoteId}/revisions/{requirementRevisionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventInventoryPlans/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryAllocationFences/{fenceId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryReservationReceipts/{receiptId} {
      allow read, write: if false;
    }

    // The superseded equipment-event projection has no active browser surface.
    // Ingredient event projections receive a separate contract in their slice.
    match /organizations/{orgId}/eventInventoryProjections/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/inventoryInsights/{periodKey} {
      allow read, write: if false;
    }

    // Kitchen BEO artifacts, immutable generation receipts, dependency
    // invalidations, and Decision Debt policy/snapshots are trusted-server
    // evidence. Staff consume bounded callable projections; artifact bytes and
    // internal reconciliation records are never browser-readable.
    match /organizations/{orgId}/kitchenBeoArtifacts/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/kitchenBeoGenerationReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Operational note journals and correction receipts can contain private
    // venue, kitchen, service, and staffing instructions. Staff access only
    // bounded callable projections; customer and browser reads stay denied.
    match /organizations/{orgId}/eventOperationalNotes/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/eventOperationalNotes/{quoteId}/receipts/{receiptId} {
      allow read, write: if false;
    }

    // Calendar connections, external-copy links, and operation receipts can
    // contain encrypted provider authorization or private reconciliation
    // evidence. Browser roles use the bounded callable projections only.
    match /organizations/{orgId}/googleCalendarConnections/{connectionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/googleCalendarEventLinks/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/googleCalendarOperations/{operationId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialChangeSimulations/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialChangeApprovalRequests/{requestId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialChangeAuthorizations/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialChangeApplyReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialChangeApplyOutcomes/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialChangeReconciliationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialDependencyState/{quoteId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/commercialDependencyState/{quoteId}/invalidations/{invalidationId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/decisionDebtPolicies/{policyId} {
      allow read, write: if false;
    }

    // Revenue Autopilot policy, templates, recipient controls, jobs, Attention
    // records, dispatch receipts, and provider evidence are trusted-server
    // authority. Staff use callable-owned, redacted projections; no browser
    // principal may read recipient/provider evidence or mutate automation state.
    match /organizations/{orgId}/revenueAutopilotPolicy/{policyId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/revenueAutopilotTemplates/{templateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/revenueAutopilotJobs/{jobId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/revenueAutopilotAttention/{attentionId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/revenueAutopilotReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/revenueAutopilotProviderEvents/{eventId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/revenueAutopilotEmailControls/{customerId} {
      allow read, write: if false;
    }

    // Global registry/index documents contain tenant and provider routing
    // evidence and are also Admin SDK only.
    match /revenueAutopilotTenants/{orgId} {
      allow read, write: if false;
    }

    match /revenueAutopilotProviderMessageIndex/{messageId} {
      allow read, write: if false;
    }

    match /revenueAutopilotSchedulerState/{stateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quotes/{quoteId} {
      allow create: if false;
      allow read: if isOrgStaff(orgId);
      allow update: if orgQuoteStaffUpdateAllowed(orgId, quoteId);
      allow update: if orgQuotePortalUpdateAllowed(orgId, quoteId);
      allow delete: if false;
    }

    match /organizations/{orgId}/quotes/{quoteId}/versions/{versionId} {
      allow read: if isOrgStaff(orgId);
      allow create: if isOrgStaff(orgId)
        && validQuoteVersionCreate(orgId, quoteId, versionId);
      allow update, delete: if false;
    }

    // Portal conversations are callable-owned. Neither a bearer portal token
    // nor a signed-in browser may read or write canonical message, retry,
    // counter, or rate-limit records directly.
    match /organizations/{orgId}/quotes/{quoteId}/portalConversationMessages/{messageId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quotes/{quoteId}/portalConversationRequests/{requestId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quotes/{quoteId}/portalConversationRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/quotes/{quoteId}/portalConversationState/{stateId} {
      allow read, write: if false;
    }

    // Structured change-request records are callable-owned attestations.
    // Same-tenant staff may read them; no browser principal may write.
    match /organizations/{orgId}/quotes/{quoteId}/changeRequestResolutions/{resolutionId} {
      allow read: if isOrgStaff(orgId);
      allow write: if false;
    }

    // Legacy global collections are retired. All business data must be org-scoped.
    match /catalogPackages/{docId} {
      allow read, write: if false;
    }

    match /catalogAddons/{docId} {
      allow read, write: if false;
    }

    match /catalogRentals/{docId} {
      allow read, write: if false;
    }

    match /pricing/settings {
      allow read, write: if false;
    }

    match /eventTypes/{docId} {
      allow read, write: if false;
    }

    match /menuCategories/{docId} {
      allow read, write: if false;
    }

    match /menuItems/{docId} {
      allow read, write: if false;
    }

    match /quotes/{quoteId} {
      allow read, write: if false;
    }

    match /customerPortalQuotes/{portalKey} {
      allow get: if portalSnapshotActive(portalKey);
      allow list: if false;
      allow create: if false;
      allow delete: if false;
      allow update: if portalStaffUpdateAllowed(portalKey);
      allow update: if portalCustomerUpdateAllowed(portalKey);
    }

    match /quoteHistory/{historyId} {
      allow read, write: if false;
    }

    match /staffInvitationProviderMessageIndex/{messageId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "schemaVersion": 1,
  "catalogVersion": "2026-09-17",
  "purpose": "Canonical observation map for QuotePilot product outcomes. It documents implemented analytics events and authoritative records that should be derived rather than duplicated. Learning summaries retain counts by category; a zero completion-action denominator produces a null resolution rate. These summary semantics add no captured event fields.",
  "statusVocabulary": [
    "implemented",
    "derivable",
    "partial",
    "specified_not_implemented",
    "blocked"
  ],
  "captureModes": [
    "client_product_event",
    "derive_from_authority_record",
    "structured_human_receipt"
  ],
  "privacy": {
    "allowedIdentity": [
      "organizationId",
      "pseudonymous sessionId",
      "bounded actor role where needed for authorization evidence"
    ],
    "prohibited": [
      "customer name",
      "customer email",
      "customer phone",
      "free text",
      "message body",
      "payment token",
      "provider secret",
      "raw request body",
      "full URL",
      "unbounded record identifier as a metric label"
    ],
    "rule": "Product analytics may observe interaction. Commercial, operational, payment, delivery, and acceptance outcomes are derived from their owning records and receipts rather than asserted by a client event."
  },
  "clientEventEnvelope": {
    "required": {
      "schemaVersion": "integer",
      "organizationId": "bounded identifier",
      "eventName": "allowlisted identifier",
      "sessionId": "pseudonymous bounded identifier",
      "sequence": "positive integer",
      "mode": "create | edit",
      "occurredAtISO": "ISO-8601 timestamp",
      "receivedAtISO": "server ISO-8601 timestamp"
    },
    "deduplication": "sha256(organizationId + newline + sessionId + newline + sequence)",
    "currentBatchLimit": 25,
    "currentSummaryWindowDays": {
      "minimum": 7,
      "default": 30,
      "maximum": 90
    },
    "currentSummaryEventLimit": 2500
  },
  "signals": [
    {
      "id": "SIG-017", "name": "quote_completion_action_shown",
      "captureMode": "client_product_event", "status": "implemented", "stage": "quote",
      "requiredFields": ["completionState, actionKind, surface: allowlisted categories"], "metricIds": ["MET-19"],
      "sourcePaths": ["src/lib/productAnalyticsAmbient.js", "functions/productAnalytics.js"]
    },
    {
      "id": "SIG-018", "name": "quote_completion_action_resolved",
      "captureMode": "client_product_event", "status": "implemented", "stage": "quote",
      "requiredFields": ["completionState, actionKind, surface, result: allowlisted categories"], "metricIds": ["MET-19"],
      "sourcePaths": ["src/lib/productAnalyticsAmbient.js", "functions/productAnalytics.js"]
    },
    {
      "id": "SIG-019", "name": "quote_completion_sendable_reached",

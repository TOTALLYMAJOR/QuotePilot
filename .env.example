# Required: Firebase web app configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Application and tenant configuration
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# App Check remains disabled until this environment has its own reviewed
# reCAPTCHA Enterprise site key and hosted monitoring evidence. The public site
# key is environment-specific; never reuse staging and production keys.
VITE_FIREBASE_APP_CHECK_ENABLED=false
VITE_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Keep organization scope empty; authenticated role/host resolution supplies it.
VITE_DEFAULT_ORGANIZATION_ID=
VITE_BASE_DOMAIN=mbmapps.com
VITE_APP_HOST=quotepilot.mbmapps.com
VITE_APP_URL=https://quotepilot.mbmapps.com/app
VITE_APP_VERSION=0.1.0
# Page-based staff workspace (Command Center, Customer 360, Messages) is the
# default. Set to false only to fall back to the legacy modal shell.
VITE_CUSTOMER_CENTERED_WORKSPACE_ENABLED=true
# Flag-gated NOW home surface (interpreted decision cards over the same
# bounded snapshot). Default off; recognized only alongside the workspace flag.
VITE_PILOT_NOW_ENABLED=false
# Flag-gated pilot Event Room dressing (readiness ring + advisory decide
# stack from the bounded quote record). Default off; presentation-only.
VITE_PILOT_EVENT_ROOM_ENABLED=false
# Flag-gated Pilot Slice Alpha. Replaces only the selected quote's staff
# presentation with the Living Opportunity proof slice. Default off and not
# bound by production workflows; existing authority and rollback paths remain.
VITE_AMBIENT_UI_ENABLED=false
# Authoritative operational staffing remains independently default-off even
# when the Ambient shell is enabled. Server and tenant authority gates must
# also be enabled before a UI receipt can be produced.
VITE_OPERATIONAL_STAFFING_ENABLED=false
# Inventory presentation is independently default-off. It exposes no authority
# unless the server environment and exact tenant gates are also enabled.
VITE_INVENTORY_AUTHORITY_ENABLED=false
# Flag-gated pilot guided-selling decide cards in the quote builder.
# Default off; apply and autopilot semantics unchanged.
VITE_PILOT_GUIDED_SELLING_ENABLED=false
# Flag-gated CREATE intake canvas (deterministic browser-only extraction that
# prefills the editable draft; see docs/INTENT_INTAKE_ADR.md). Default off.
VITE_PILOT_CREATE_ENABLED=false
# Flag-gated client-request panel in the quote editor (deterministic parse of
# the stored change-request message into stageable draft edits). Default off.
VITE_PILOT_CHANGE_REQUESTS_ENABLED=false

# Public invoice-first buyer access. Generic builds remain off. A production
# preparation artifact may enable both flags only with a syntactically valid,
# non-placeholder public Turnstile site key. Provider setup and human review
# remain separate; the Firebase Functions gate is independently disabled by default.
VITE_BUYER_ACCESS_ENABLED=false
VITE_BUYER_ACCESS_PUBLIC_CTA_ENABLED=false
# Public site key only (never the Turnstile secret).
VITE_BUYER_ACCESS_TURNSTILE_SITE_KEY=

# Optional runtime tuning (milliseconds)
VITE_ORG_BOOTSTRAP_TIMEOUT_MS=12000
VITE_SAVE_FLOW_TIMEOUT_MS=30000
VITE_SAVE_CALLABLE_TIMEOUT_MS=45000
VITE_OWNER_SMS_TIMEOUT_MS=15000
VITE_TENANT_CONTEXT_TTL_MS=600000
VITE_TENANT_NEGATIVE_TTL_MS=30000

# Local demo development only: opt in deliberately. Production must remain false.
VITE_ALLOW_LOCAL_CATALOG_FALLBACK=false

# Optional Firebase emulator connection
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# Stripe, Twilio, and Resend credentials are server-only. Never add them to a
# VITE_* variable or this frontend file. Use placeholder guidance in
# functions/.env.example and keep real values in an ignored Functions env file.
# Flag-gated Pilot command bar in the quote builder (deterministic
# preview-confirm commands; voice via browser speech when available).
VITE_PILOT_COMMAND_ENABLED=false
# Existing v0.7 customer proposal decision-room subset. The expanded AIUI-46
# presentation and reversible option feedback also require Ambient UI.
VITE_PILOT_DECISION_ROOM_ENABLED=false
# Flag-gated staff-only margin strip (fail-closed: computes only from
# tenant-recorded costs — costPpp, item cost, *CostRate — never estimates).
VITE_PILOT_MARGINS_ENABLED=false

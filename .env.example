VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_DEFAULT_ORGANIZATION_ID=default-org
VITE_BASE_DOMAIN=mbmapps.com
VITE_SHARED_APP_HOSTS=app.mbmapps.com,quotepilot.mbmapps.com
VITE_ENABLE_LEGACY_GLOBAL_FALLBACK=true
# Optional: comma-separated list of staff emails to auto-bootstrap as admins on first sign-in.
VITE_BOOTSTRAP_ADMIN_EMAILS=owner@yourdomain.com

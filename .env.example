# Required: Firebase web app configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Application and tenant configuration
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_DEFAULT_ORGANIZATION_ID=your_organization_id
VITE_BASE_DOMAIN=yourdomain.com
VITE_AUTH_CLAIMS_MODE=dual
# Optional: comma-separated staff emails allowed to bootstrap as admins.
VITE_BOOTSTRAP_ADMIN_EMAILS=owner@yourdomain.com
VITE_APP_VERSION=0.1.0

# Optional runtime tuning (milliseconds)
VITE_ORG_BOOTSTRAP_TIMEOUT_MS=12000
VITE_SAVE_FLOW_TIMEOUT_MS=30000
VITE_SAVE_CALLABLE_TIMEOUT_MS=45000
VITE_OWNER_SMS_TIMEOUT_MS=15000
VITE_TENANT_CONTEXT_TTL_MS=600000
VITE_TENANT_NEGATIVE_TTL_MS=30000

# Local development only: keep production unset/false.
VITE_ALLOW_LOCAL_CATALOG_FALLBACK=true

# Optional Firebase emulator connection
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# Stripe, Twilio, and Resend credentials are server-only. Never add them to a
# VITE_* variable or this frontend file. See docs/LAUNCH_RUNBOOK.md.

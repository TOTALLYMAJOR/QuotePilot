  "products": {
    "quotepilot": {
      "archetype": "transactional-commercial",
      "rules": [
        {
          "category": "semantic-correctness",
          "id": "DL-QP-AUTH-001",
          "protected": true,
          "sourceAuthority": "docs/DESIGN-CONTRACT.md",
          "sourceLines": [14, 24],
          "statement": "Product truth, authorization, pricing, payment, and provider boundaries outrank visual treatment and institutional-memory summaries."
        },
        {
          "category": "semantic-correctness",
          "id": "DL-QP-AUTH-002",
          "protected": true,
          "sourceAuthority": "docs/DESIGN-CONTRACT.md",
          "sourceLines": [22, 24],
          "statement": "No presentation may imply that a quote saved, a message delivered, a payment settled, or an event booked before the authoritative service establishes that state."
        },
        {
          "category": "product-requirement",
          "id": "DL-QP-DOC-001",
          "protected": true,
          "sourceAuthority": "docs/DOC_SYSTEM.md",
          "sourceLines": [5, 7],
          "statement": "Each major topic has one canonical source of truth; institutional memory indexes and retrieves that authority instead of duplicating it."
        },
        {
          "category": "hierarchy",
          "id": "DL-QP-UX-001",
          "protected": false,
          "sourceAuthority": "docs/DESIGN_PRINCIPLES.md",
          "sourceLines": [61, 67],
          "statement": "The useful next action must be visually undeniable and its consequence clear before activation."
        },
        {
          "category": "content",
          "id": "DL-QP-UX-002",
          "protected": false,
          "sourceAuthority": "docs/DESIGN_PRINCIPLES.md",
          "sourceLines": [26, 29],
          "statement": "Internal implementation vocabulary stays out of customer-facing copy while operator-owned catering vocabulary remains available as signal."
        },
        {
          "category": "product-requirement",
          "id": "DL-QP-COMP-001",
          "protected": true,
          "sourceAuthority": "docs/DESIGN-CONTRACT.md",
          "sourceLines": [43, 58],
          "statement": "Reference logic must integrate through the existing QuotePilot runtime, tokens, components, and mutation paths rather than creating a parallel application shell."
        },
        {
          "category": "evidence",
          "id": "DL-QP-REF-001",
          "protected": true,
          "sourceAuthority": "docs/DESIGN-CONTRACT.md",
          "sourceLines": [45, 65],
          "statement": "External design references are evidence to deconstruct and adapt, not authority or a visual identity to copy."
        },
        {
          "category": "responsive",
          "id": "DL-QP-RESP-001",
          "protected": false,
          "sourceAuthority": "docs/DESIGN_SYSTEM.md",
          "sourceLines": [55, 60],
          "statement": "The first useful viewport at 390, 768, and 1440 pixels keeps identity, authoritative state, material risk, and the next action legible."
        },
        {
          "category": "accessibility",
          "id": "DL-QP-A11Y-001",
          "protected": true,
          "sourceAuthority": "docs/DESIGN_SYSTEM.md",
          "sourceLines": [64, 89],
          "statement": "Sensory feedback always retains textual acknowledgement, reduced-motion behavior, and visible focus and system-state representation."
        },
        {
          "category": "repository-governance",
          "id": "DL-QP-GOV-001",
          "protected": true,
          "sourceAuthority": "AGENTS.md",
          "sourceLines": [18, 32],
          "statement": "UI work follows repository planning, loads design-language, uses QuotePilot design authorities as local truth, and runs scope-specific validation."
        }
      ]
    }
  },

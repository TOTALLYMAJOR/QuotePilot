{
  "$defs": {
    "fileEvidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "humanEvidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "reviewedAt": {
          "format": "date-time",
          "type": "string"
        },
        "reviewedBy": {
          "pattern": "^human:.+",
          "type": "string"
        },
        "scope": {
          "enum": [
            "visual-acceptance",
            "semantic-accessibility"
          ]
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "status": {
          "const": "PASS"
        }
      },
      "required": [
        "path",
        "sha256",
        "status",
        "reviewedBy",
        "reviewedAt",
        "scope"
      ],
      "type": "object"
    }
  },
  "$id": "https://totallymajor.local/schemas/baseline-review-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "APPROVE"
          }
        }
      },
      "then": {
        "required": [
          "decisionMemoryId",
          "validUntil",
          "visualAcceptanceEvidence",
          "semanticAccessibilityEvidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "DEFER"
          }
        }
      },
      "then": {
        "required": [
          "reviewAfter"
        ]
      }
    }
  ],
  "properties": {
    "authorizedBy": {
      "pattern": "^human:.+",
      "type": "string"
    },
    "baselineMutationPerformed": {
      "const": false
    },
    "decidedAt": {
      "format": "date-time",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "DEFER"
      ]
    },
    "decisionMemoryId": {
      "pattern": "^DL-.+",
      "type": "string"
    },
    "id": {
      "pattern": "^BDR-[A-F0-9]{16}$",
      "type": "string"
    },
    "promotionPerformed": {
      "const": false
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "requestEvidence": {
      "$ref": "#/$defs/fileEvidence"
    },
    "requestId": {
      "pattern": "^BR-[A-F0-9]{16}$",
      "type": "string"
    },
    "reviewAfter": {
      "format": "date-time",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "semanticAccessibilityEvidence": {
      "$ref": "#/$defs/humanEvidence"
    },
    "supersedes": {
      "pattern": "^BDR-[A-F0-9]{16}$",
      "type": [
        "string",
        "null"
      ]
    },
    "validUntil": {
      "format": "date-time",
      "type": "string"
    },
    "visualAcceptanceEvidence": {
      "$ref": "#/$defs/humanEvidence"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "requestId",
    "requestEvidence",
    "decision",
    "authorizedBy",
    "reason",
    "decidedAt",
    "supersedes",
    "baselineMutationPerformed",
    "promotionPerformed"
  ],
  "title": "Baseline Review Decision Receipt",
  "type": "object"
}

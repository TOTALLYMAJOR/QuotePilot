{
  "name": "react-firebase-quote-wizard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "classify:ci:lanes": "node ./scripts/ci-lane-classifier.mjs",
    "lane:quick": "bash ./scripts/orchestration-lanes.sh lane:quick",
    "lane:core": "bash ./scripts/orchestration-lanes.sh lane:core",
    "lane:firebase-auth-rules": "bash ./scripts/orchestration-lanes.sh lane:firebase-auth-rules",
    "lane:authoritative-pricing": "bash ./scripts/orchestration-lanes.sh lane:authoritative-pricing",
    "lane:release": "bash ./scripts/orchestration-lanes.sh lane:release",
    "lane:release:cwv": "bash ./scripts/orchestration-lanes.sh lane:release --with-cwv",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:rules:firestore": "npx firebase-tools --config firebase.e2e.json --project demo-quote-wizard-rules emulators:exec --only firestore \"vitest run src/rules/__tests__/firestore.rules.test.js\"",
    "test:e2e": "bash ./scripts/run-playwright.sh test",
    "test:e2e:headed": "bash ./scripts/run-playwright.sh test --headed",
    "test:e2e:firebase": "node ./scripts/run-firebase-e2e.mjs",
    "test:e2e:firebase:authoritative": "node ./scripts/run-firebase-e2e-authoritative.mjs",
    "check:env": "node ./scripts/check-env.mjs",
    "check:workflows": "node ./scripts/check-github-workflows.mjs",
    "env:local:firebase": "node ./scripts/configure-local-firebase-env.mjs",
    "seed:menu:firestore": "node ./scripts/seed-firestore-menu.mjs",
    "customer:provision": "node ./scripts/provision-customer-order.mjs",
    "migrate:multi-tenant": "node ./scripts/migrate-to-multi-tenant.mjs",
    "migrate:multi-tenant:dry-run:evidence": "node ./scripts/migrate-to-multi-tenant.mjs --dry-run --evidence-out ./artifacts/migration/multi-tenant-dry-run-evidence.json",
    "portal:backfill": "node ./scripts/backfill-portal-snapshots.mjs",
    "test:portal-backfill:emulator": "npx firebase-tools --config firebase.e2e.json --project demo-portal-backfill emulators:exec --only firestore \"vitest run src/lib/__tests__/portalSnapshotBackfill.emulator.test.js\"",
    "check:secrets": "node ./scripts/check-secret-assets.mjs",
    "check:docs:governance": "node ./scripts/check-doc-governance.mjs",
    "check:perf:bundle": "node ./scripts/check-bundle-budget.mjs",
    "check:perf:cwv": "bash ./scripts/run-lighthouse-cwv.sh",
    "release:uat:digest": "node ./scripts/release-uat-attestation.mjs --print-digest",
    "release:uat:items": "node ./scripts/release-uat-attestation.mjs --print-items",
    "release:evidence:verify": "node ./scripts/production-release-evidence.mjs",
    "release:artifact:stage": "node ./scripts/stage-production-payload.mjs",
    "release:artifact:prepare": "node ./scripts/prepare-production-artifact.mjs",
    "deploy:firebase:backend": "node ./scripts/deploy-firebase-production.mjs --scope backend",
    "deploy:firebase:hosting": "node ./scripts/deploy-firebase-production.mjs --scope hosting",
    "deploy:firebase:hosting:customer": "node ./scripts/deploy-hosting-customer.mjs",
    "deploy:firebase": "node ./scripts/deploy-firebase-production.mjs --scope all",
    "deploy:vercel": "node ./scripts/deploy-vercel-production.mjs"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "jspdf": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.54.2",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}

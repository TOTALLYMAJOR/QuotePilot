# Firebase Functions runtime configuration.
# Copy to .env.<firebase-project-id> inside functions/ and keep that file ignored.
# Never commit real provider credentials.

# Canonical QuotePilot URLs and authorization posture
APP_BASE_URL=https://quotepilot.mbmapps.com/app
APP_BASE_DOMAIN=mbmapps.com
# Required for provisioning: explicit verified platform operators only.
# Tenant admins must never appear here.
AUTH_PLATFORM_ADMIN_EMAILS=

# Commercial Change Authority enforcement is independently dormant until both
# this server gate and the trusted tenant setting
# `commercialChangeAuthorityEnabled` are true. Browser clients cannot promote
# the tenant setting. Source availability is not release authorization.
COMMERCIAL_CHANGE_AUTHORITY_ENABLED=false

# Authoritative operational staffing is independently dormant until both this
# server gate and the trusted tenant setting
# `operationalStaffingAuthorityEnabled` are true. Browser principals cannot
# promote either gate. Source availability is not release authorization.
OPERATIONAL_STAFFING_AUTHORITY_ENABLED=false

# Inventory physical truth and every later inventory authority remain dormant
# until this server gate and the exact tenant's trusted
# `inventoryAuthorityEnabled` setting are both true. Inventory callables also
# require App Check and never accept direct browser writes to canonical records.
INVENTORY_AUTHORITY_ENABLED=false

# Team role authority begins in App Check monitoring mode. Promote to enforce
# only after environment-specific reCAPTCHA Enterprise keys, one-hour TTL,
# metrics, hosted acceptance, and the App Check verifier IAM binding are proven.
# Replay enforcement is valid only with App Check enforcement and is reserved
# for the high-risk role-mutation callable.
ORGANIZATION_ROLE_APP_CHECK_MODE=monitor
ORGANIZATION_ROLE_APP_CHECK_REPLAY_PROTECTION=disabled

# Revenue Autopilot has two independent release gates. Keep both false until
# the scheduler, approved Resend sender, webhook, hosted staff acceptance, and
# explicit release decision are complete. Tenant policy and customer consent
# remain separate Firestore authority and cannot promote these server gates.
REVENUE_AUTOPILOT_ENABLED=false
REVENUE_AUTOPILOT_SENDS_ENABLED=false
# Store REVENUE_AUTOPILOT_TOKEN_SECRET in Firebase Secret Manager. It signs
# customer unsubscribe links and must never be added to a dotenv file.
# Store STAFF_INVITATION_TOKEN_SECRET separately in Firebase Secret Manager. It
# signs exact assignment response links and must never be added to a dotenv file.
# Signed Resend events share revenueAutopilotResendWebhook and are routed by the
# server-owned provider-message index; RESEND_WEBHOOK_SECRET remains authoritative.

# Email stays disabled until the shared verified sender is released and tested.
# After provider, release, and delivery acceptance, set NOTIFICATIONS_EMAIL_PROVIDER=resend.
NOTIFICATIONS_EMAIL_PROVIDER=none
EMAIL_FROM_NAME=QuotePilot by MBMApps
EMAIL_FROM_EMAIL=quotepilot@quietpilot.us
# Store RESEND_API_KEY in Firebase Secret Manager. For local Functions emulator
# runs only, provide it through the ignored functions/.secret.local file.

# SMS stays disabled until one provider's sender/compliance inventory, signed
# delivery webhook, and a controlled provider round trip are accepted. Runtime
# selection is explicit; credential presence never selects a provider.
NOTIFICATIONS_SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
PINGRAM_API_ORIGIN=
PINGRAM_FROM_NUMBER=
PINGRAM_CONFIGURATION_GENERATION=
NOTIFICATIONS_OWNER_PHONE=
NOTIFICATIONS_OWNER_SMS_CONSENT=
# Store TWILIO_AUTH_TOKEN in Firebase Secret Manager. For local Functions
# emulator runs only, provide it through the ignored functions/.secret.local file.
# Store the shared SMS_CONTACT_DIGEST_SECRET for either sending provider, plus
# PINGRAM_API_KEY and PINGRAM_WEBHOOK_SECRET for Pingram, in Firebase Secret
# Manager. Pingram production currently uses an exact approved origin such as
# https://api.pingram.io; do not place any SMS secret in this dotenv file.

# Stripe values are server-only.
# Production quote-payment rails must use live. Local/emulator fixtures must
# explicitly use test.
STRIPE_MODE=
# Store STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in Firebase Secret Manager.
# For local Functions emulator runs only, provide them through the ignored
# functions/.secret.local file.

# Public invoice-first buyer access on the tonicatering Firebase project. Keep
# the server gate off until Turnstile, durable rate limits, Stripe test invoice
# lifecycle, verified activation, and release UAT have all been accepted. This
# rail remains isolated from the live quote-payment rail.
BUYER_ACCESS_ENABLED=false
BUYER_ACCESS_STRIPE_MODE=test
BUYER_ACCESS_APP_BASE_URL=https://quotepilot.mbmapps.com/app
BUYER_ACCESS_TURNSTILE_HOSTNAMES=quotepilot.mbmapps.com,tonicatering.web.app
# Store these four values in Firebase Secret Manager; never add them here:
# BUYER_ACCESS_STRIPE_SECRET_KEY
# BUYER_ACCESS_STRIPE_WEBHOOK_SECRET
# BUYER_ACCESS_TURNSTILE_SECRET
# BUYER_ACCESS_RATE_LIMIT_SECRET

# Public guided inquiry pages. Keep the global gate off until a tenant is
# explicitly enabled, the dedicated Turnstile hostname list is accepted, and
# local/emulator plus hosted release evidence are complete. These credentials
# are intentionally separate from buyer-access verification.
INQUIRY_SHOWCASE_ENABLED=false
# Set only when INQUIRY_SHOWCASE_ENABLED=true after tenant qualification:
# INQUIRY_TURNSTILE_HOSTNAMES=quotepilot.mbmapps.com,tonicatering.web.app
# Store INQUIRY_TURNSTILE_SECRET and INQUIRY_RATE_LIMIT_SECRET in Firebase
# Secret Manager; never add their values here.

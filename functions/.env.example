# Firebase Functions runtime configuration.
# Copy to .env.<firebase-project-id> inside functions/ and keep that file ignored.
# Never commit real provider credentials.

# Canonical QuotePilot URLs and authorization posture
APP_BASE_URL=https://quotepilot.mbmapps.com/app
APP_BASE_DOMAIN=mbmapps.com
# Required for provisioning: explicit verified platform operators only.
# Tenant admins must never appear here.
AUTH_PLATFORM_ADMIN_EMAILS=

# Email stays disabled until the sender domain is verified in Resend.
# After verification, set NOTIFICATIONS_EMAIL_PROVIDER=resend.
NOTIFICATIONS_EMAIL_PROVIDER=none
EMAIL_FROM_NAME=QuotePilot by MBMapps
EMAIL_FROM_EMAIL=onboarding@quotepilot.mbmapps.com
RESEND_API_KEY=

# SMS stays disabled until Twilio sender registration and a live send pass.
NOTIFICATIONS_SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATIONS_OWNER_PHONE=

# Stripe values are server-only.
# Production must use live. Local/emulator fixtures must explicitly use test.
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
